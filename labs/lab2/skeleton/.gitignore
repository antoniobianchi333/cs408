# Generated by setup.sh / scripts/setup.py
/.tools/
/.venvs/
# udocker image store (default location)
/.cache/udocker/
# tectonic package cache (TECTONIC_CACHE_DIR, set by scripts/activate.sh)
/.cache/tectonic/
# Image archives downloaded into images/
/images/*.tar.gz
# Your own runs (jobs/<alias>/); shipped vanilla jobs and submissions are tracked
/jobs/*
!/jobs/vanilla/
!/jobs/submission/
# Python bytecode
__pycache__/
